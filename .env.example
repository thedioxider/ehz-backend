# Tag of the published images, or the local tag the dev overlay will produce.
EHZ_VERSION=latest

# Postgres password. Leave as the default and re-run `docker compose up -d` —
# the app reads/generates its own API credentials at /data/credentials.txt on
# first boot. Set this only if you need a specific static DB password.
POSTGRES_PASSWORD=ehz

# Advanced: override the LAN IP advertised by the discovery sidecar.
# Defaults to 'auto' (first non-loopback IPv4). Set to a specific IP on
# multi-NIC hosts.
# EHZ_ANNOUNCE_IP=auto
